# TravelMate Backend Production Environment Variables
PORT=5000
NODE_ENV=production

# Neon PostgreSQL Connection String (Direct or Pooled)
# Note: Ensure sslmode=require is appended to enforce SSL
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require

# Security & Authentication
JWT_SECRET=super_secret_production_key_change_me_to_at_least_32_random_bytes
JWT_EXPIRES_IN=7d

# Financial Engine
BASE_CURRENCY=INR

# Connection Pool Limit (Recommended: 10 for Neon Free Tier compute)
DB_POOL_MAX=10

# CORS Whitelist (Comma-separated URLs of your deployed Vercel frontend)
CORS_ORIGIN=https://travelmate-frontend.vercel.app,https://your-custom-domain.com
